def draw_board(board):
   print("~~~~~~~~~~~~~~~~~~")
   print(f"|| {board[0]} || {board[1]} || {board[2]} ||")
   print("~~~~~~~~~~~~~~~~~~")
   print(f"|| {board[3]} || {board[4]} || {board[5]} ||")
   print("~~~~~~~~~~~~~~~~~~")
   print(f"|| {board[6]} || {board[7]} || {board[8]} ||")
   print("~~~~~~~~~~~~~~~~~~")


def get_player_input(plr, current_pieces):
   while True:
       try:
           move = int(input(f"{plr}: Where would you like to place your piece (1 - 9): "))
       except ValueError:
           print("That can't be a move please enter a number 1-9)")
           continue


       if 1 <= move <= 9:
           if current_pieces[move - 1] == "_":
               return move - 1
           else:
               print("That's taken buddy")
       else:
           print("That can't be a move bud")


def place_char_on_board(plr, move, current_pieces):
   current_pieces[move] = plr


def is_winner(current_pieces, player_char):
   # Horizontal wins
   if (current_pieces[0] == player_char and current_pieces[1] == player_char and current_pieces[2] == player_char):
       return True
   elif (current_pieces[3] == player_char and current_pieces[4] == player_char and current_pieces[5] == player_char):
       return True
   elif (current_pieces[6] == player_char and current_pieces[7] == player_char and current_pieces[8] == player_char):
       return True
   # Vertical wins
   elif (current_pieces[0] == player_char and current_pieces[3] == player_char and current_pieces[6] == player_char):
       return True
   elif (current_pieces[1] == player_char and current_pieces[4] == player_char and current_pieces[7] == player_char):
       return True
   elif (current_pieces[2] == player_char and current_pieces[5] == player_char and current_pieces[8] == player_char):
       return True
   # Diagonal wins
   elif (current_pieces[0] == player_char and current_pieces[4] == player_char and current_pieces[8] == player_char):
       return True
   elif (current_pieces[2] == player_char and current_pieces[4] == player_char and current_pieces[6] == player_char):
       return True


   return False


